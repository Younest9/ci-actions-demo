{
  "name": "ci-actions-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Node/TypeScript project with lint, tests, and GitHub Actions CI",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "test": "node --import tsx --test src/lib.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
